# ===== 后端环境变量模板 =====
# 用法：
#   cp backend/.env.example backend/.env
#   然后填入真实值。backend/.env 已被 .gitignore 忽略，绝不会被提交。

# ---- 第三方 AI 模型 API ----
# 剧本解析用的大语言模型
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# 视频生成（可灵 / 即梦 / Replicate 等）
VIDEO_API_KEY=
VIDEO_API_BASE_URL=
VIDEO_MODEL=

# 图片生成
IMAGE_API_KEY=
IMAGE_API_BASE_URL=
IMAGE_MODEL=

# ---- 本地服务 ----
# Dify 工作流（可选）
DIFY_API_KEY=
DIFY_BASE_URL=
DIFY_WORKFLOW_ID=

# ComfyUI（可选，本地默认端口 8188）
COMFYUI_BASE_URL=http://127.0.0.1:8188

# ---- 数据库 ----
# 默认使用 SQLite，无需配置；切 PostgreSQL 时填这里
DATABASE_URL=sqlite:///./data/pipeline.db
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/aifilm

# ---- Redis / Celery（第 7 课用） ----
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
